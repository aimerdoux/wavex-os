# WaveX OS — environment variables
# ----------------------------------
# Copy to `.env` (gitignored), fill in the secret values, and restart
# `pnpm dev`. The mock-core server (packages/mock-core/src/server.ts)
# auto-loads this file via process.loadEnvFile().

# ── Composio (real OAuth + full toolkit catalog) ────────────────────
# Get a key from https://app.composio.dev → Settings → API Keys.
# Flipping WAVEX_COMPOSIO_DISABLED=0 switches the connectors directory
# from the curated 16-toolkit fallback to Composio's live catalog
# (~200+ toolkits with logos + categories).
COMPOSIO_API_KEY=
WAVEX_COMPOSIO_DISABLED=0

# ── Anthropic (T2 tier calls in apikey mode) ────────────────────────
# Only needed when WAVEX_INFERENCE_MODE=apikey (default in production).
# In dev, the tier-router uses OAuth via the Claude Code wrapper; leave
# this unset unless you're testing the apikey path.
# ANTHROPIC_API_KEY=

# ── Composio webhook callbacks (optional) ───────────────────────────
# If you're testing OAuth on a non-localhost domain, set the public
# origin Composio should redirect back to.
# WAVEX_PUBLIC_ORIGIN=https://your-tunnel.ngrok.app
